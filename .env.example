# Dibuat/diisi oleh skrip server (Tahap 3: scripts/update.sh). Jangan commit .env.
POSTGRES_PASSWORD=
# Alamat publik Maung WO yang bisa dijangkau dari container (mis. https://maung.liv.net.id)
WO_URL=
# openssl rand -hex 32
FILE_SIGN_SECRET=
S3_BUCKET=crm-photos
# Garage bersama (stack maung-garage, repo WO): kunci dibuat/ditulis oleh scripts/garage-app.sh crm --env-file <.env ini>
S3_ACCESS_KEY=
S3_SECRET_KEY=
# WAJIB: SHA commit image (CI memberi tag SHA; `latest` hanya alias informatif dan TIDAK dipakai compose)
IMAGE_TAG=
# Cermin pelanggan WO (Export API, baca-saja). Isi lewat scripts/set-export-key.sh (kunci tidak ditempel di chat). Kosong = sinkron nonaktif.
WO_EXPORT_API_KEY=
# Menit antar tarik penuh (minimal 5)
SYNC_INTERVAL_MIN=30
# Negara bawaan untuk nomor berawalan 0 (kode ISO), nomor dengan +/00 dan kode negara selalu diprioritaskan
PHONE_DEFAULT_REGION=ID
