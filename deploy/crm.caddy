# crm.caddy — diserahkan ke pemilik/sesi WO untuk ditaruh di proxy/apps/crm.caddy (repo WO). CRM tidak menyentuh Caddy/WO.
# Di-import DI DALAM blok situs WO, jadi hanya berisi direktif `handle`. Aturan lebih spesifik ditulis LEBIH DULU.
# JANGAN dipasang sebelum Tahap 2 (compose crm-web/crm-api di jaringan maung_edge) diterapkan — sebelum itu /crm akan 502.
handle /crm/api/* {
	reverse_proxy crm-api:4000
}
handle /crm/* {
	reverse_proxy crm-web:3000
}
